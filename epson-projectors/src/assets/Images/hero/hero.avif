<script>
    window.globalConfig = window.globalConfig || {};
    window.globalConfig.datalayer = window.globalConfig.datalayer || {};
    window.globalConfig.datalayer.pageTemplate =
        window.globalConfig.datalayer.pageTemplate || '';
</script>

<script>
    (function () {
        try {
            function getValue(selector) {
                var el = document.querySelector(selector);
                return el ? el.value : '';
            }

            window.globalConfig.ecommerce =
                window.globalConfig.ecommerce || {};
            window.globalConfig.ecommerce.priceSettings =
                window.globalConfig.ecommerce.priceSettings || {};
            window.globalConfig.ecommerce.stockStatus =
                window.globalConfig.ecommerce.stockStatus || {};
            window.globalConfig.ecommerce.discountLabels =
                window.globalConfig.ecommerce.discountLabels || {};
            window.globalConfig.api =
                window.globalConfig.api || {};
            window.globalConfig.api.endpoints =
                window.globalConfig.api.endpoints || {};
            window.globalConfig.notifyMe =
                window.globalConfig.notifyMe || {};
            window.globalConfig.site =
                window.globalConfig.site || {};

            /*
             * Author instance includes:
             * - AEM Editor
             * - Preview mode
             * - View as Published (wcmmode=disabled)
             *
             * Publish instance returns false.
             */
            Object.defineProperty(window.globalConfig.site, 'isAuthor', {
                value: false,
                writable: true,
                configurable: true,
                enumerable: false
            });

            window.globalConfig.product =
                window.globalConfig.product || {};
            window.globalConfig.commerceConnector =
                window.globalConfig.commerceConnector || {};
            window.globalConfig.pincodeChecker =
                window.globalConfig.pincodeChecker || {};
            window.globalConfig.user =
                window.globalConfig.user || {};
            window.globalConfig.cookies =
                window.globalConfig.cookies || {};

            window.globalConfig.ecommerce.priceSettings.decimalPoint =
                window.globalConfig.ecommerce.priceSettings.decimalPoint ||
                getValue('input[name="priceDecimalPoint"]');

            window.globalConfig.ecommerce.priceSettings.enableThousandSeparator =
                window.globalConfig.ecommerce.priceSettings.enableThousandSeparator ||
                getValue('input[name="enablePriceThousandSeparator"]');

            window.globalConfig.ecommerce.enableMagento =
                window.globalConfig.ecommerce.enableMagento ||
                getValue('#enableMagento');

            window.globalConfig.ecommerce.memberRegion =
                window.globalConfig.ecommerce.memberRegion ||
                getValue('input[name="memberCenterRegion"]');

            window.globalConfig.ecommerce.currency =
                window.globalConfig.ecommerce.currency ||
                getValue('input[name="currency"]');

            window.globalConfig.ecommerce.magentoRegion =
                window.globalConfig.ecommerce.magentoRegion ||
                getValue('input[name="magentoRegion"]');

            window.globalConfig.ecommerce.magentoStoreID =
                window.globalConfig.ecommerce.magentoStoreID ||
                getValue('input[name="magentoStoreID"]');

            window.globalConfig.api.endpoints.queryMixedProduct =
                window.globalConfig.api.endpoints.queryMixedProduct ||
                getValue('input[name="queryMixedProductUrl"]');

            window._globalConfigExecuted = true;
        } catch (e) {
            window._globalConfigError = e.message;
            console.error('[global-config] failed', e);
        }
    })();
</script>
    
        
    
    
    
        



    
    
